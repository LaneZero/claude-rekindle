{
  "manifest_version": 3,
  "name": "ClaudeRekindle by LaneZero",
  "version": "2.4.0",
  "description": "Auto-clicks the enabled Continue button for Claude usage pauses or responses that end early. Saves reset reminders. No limit bypass; independent of Anthropic.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ClaudeRekindle",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-rekindle@lanezero",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
